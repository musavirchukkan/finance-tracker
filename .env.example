# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Neon (recommended for Vercel) ---
# Pooled connection — used by the Next.js app at runtime
# Neon dashboard → Connection details → "Pooled connection" (host often contains -pooler)
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct connection — used by drizzle-kit (db:push) and seed scripts
# Neon dashboard → Connection details → "Direct connection" (no -pooler)
DATABASE_MIGRATION_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# --- Local Docker alternative (npm run db:up) ---
# DATABASE_URL=postgresql://finance:finance@localhost:5432/finance
# DATABASE_MIGRATION_URL=postgresql://finance:finance@localhost:5432/finance

# Optional: first user created by `npm run db:seed`
SEED_EMAIL=you@example.com
SEED_PASSWORD=changeme123
SEED_NAME=Musavir
