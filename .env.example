# openssl rand -base64 32
AUTH_SECRET=

# Canonical site URL for Auth.js (set on deploy; optional locally with trustHost)
# AUTH_URL=https://your-app.vercel.app

# Neon: pooled for app, direct for migrate/seed
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_MIGRATION_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Local Docker (npm run db:up)
# DATABASE_URL=postgresql://finance:finance@localhost:5432/finance
# DATABASE_MIGRATION_URL=postgresql://finance:finance@localhost:5432/finance

# Signup: closed by default in production. Open locally unless set false.
# ALLOW_PUBLIC_SIGNUP=true
# SIGNUP_INVITE_CODE=your-private-code

# Allow `npm run db:seed` in production (otherwise blocked)
# ALLOW_DB_SEED=true

# Redis REST (Upstash-compatible). Optional locally; use in production for shared rate limits
# REDIS_REST_URL=
# REDIS_REST_TOKEN=

# cron-job.org → /api/cron/keepalive?target=redis|neon|both
# Header: Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# Sentry (optional). Empty disables the SDK.
# Browser events tunnel via /monitoring (same-origin) so CSP connect-src stays 'self'.
# NEXT_PUBLIC_SENTRY_DSN is a public project key (not a secret).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# npm run db:seed
SEED_EMAIL=you@example.com
SEED_PASSWORD=changeme123
SEED_NAME=Musavir
